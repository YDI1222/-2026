# このファイルをコピーして config/local.env を作り、自分のMacに合わせて書き換えます。
#   cp config/local.env.example config/local.env
# local.env は Git に入りません（.gitignore 済み）。
# ここには「場所」だけを書きます。パスワード・APIキー・トークンは絶対に書かないでください。

# --- Obsidian（正規の保管庫）---
# 診断スクリプト（workflows/obsidian_sync/diagnose_mac.sh）の結果を見て、正しい1つを書きます。
VAULT_PATH="$HOME/Documents/Second Brain"

# --- Google Drive（AI参照用コピーの置き場所）---
# Google Drive for desktop の「マイドライブ」内のフォルダ。存在しない場合は同期を止めます（勝手に作りません）。
# 2026-10-12 時点で現在も更新が続いているのはマイドライブ直下の「Second Brain」でした（調査レポート参照）。
DRIVE_DEST="$HOME/Library/CloudStorage/GoogleDrive-（Googleアカウントのメールアドレス）/マイドライブ/Second Brain"

# --- どのMacが担当するか ---
# 2台が同時に同じフォルダへ書き込むと、Drive上で重複ファイルが生まれやすくなります。
# 主担当（普段のコピー役）のMac名。`scutil --get ComputerName` で確認できます。
PRIMARY_HOST="Mac mini"
# 主担当以外のMacは、最後の成功からこの時間以上たっている時だけ代わりにコピーします。
FALLBACK_AFTER_HOURS=26

# --- iPhoneの更新を確実に拾うための設定 ---
# Obsidian Sync はObsidianアプリが起動している間に同期します。
# 1 にすると、コピー前にObsidianを裏で起動し、WAIT_FOR_OBSIDIAN_SEC 秒待ってからコピーします。
OPEN_OBSIDIAN_BEFORE_SYNC=1
WAIT_FOR_OBSIDIAN_SEC=180

# --- 削除の反映（初期値は「反映しない」）---
# 0：保管庫で消したノートもDrive側には残る（安全・初期値）
# 1：Drive側からも消す。ただし消す前に Drive 内の _sync_backup/日時/ に退避します。
MIRROR_DELETE=0

# --- コンテンツ設計への反映（Insight Digest）---
# 1 にすると、コピーのたびに Obsidian の「本人の言葉」を取り出し、
# Drive の Second Brain/_AI_digest/insight_digest_latest.md に置きます（SNS原稿づくりの主な材料）。
# 業務記録フォルダ（obsidian_sync_excludes.txt）と、個人が特定されうる記述は含めません。
INSIGHT_DIGEST=1
# 何日前までのノートを材料にするか（0 は全期間）
INSIGHT_DAYS=14
# all：全ノートから「本人の声」を拾う／marked：#発信候補 や「問い：」「気づき：」「体験：」の印があるものだけ
INSIGHT_SCOPE=all
