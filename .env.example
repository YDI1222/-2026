# ---------------------------------------------------------------- 必須ではない
# 何も設定しなくても「カレンダー連携なしの日程調整」として動きます。

# アプリの公開URL。共有する文面に載るので、本番では自分のドメインに。
APP_URL=http://localhost:3000

# ------------------------------------------------ Google 連携（任意・推奨）
# Google Cloud Console →「APIとサービス」→「認証情報」で発行します。
# 承認済みリダイレクトURI に  <APP_URL>/api/auth/google/callback  を登録してください。
# 詳しい手順は http://localhost:3000/setup にも出しています。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------ LINE 送信（任意）
# LINE 公式アカウント（Messaging API）のチャネルアクセストークン。
# 未設定なら push 機能は無効になり、ワンタップ共有だけが使えます。
# ※ LINE Notify は 2025-03-31 に終了しています。後継は Messaging API です。
LINE_CHANNEL_ACCESS_TOKEN=

# --------------------------------------------- Messenger 共有（任意）
# PCブラウザから Messenger の送信ダイアログを開くために使う Facebook アプリID。
# 未設定でも、スマートフォンからは共有シート経由で送れます。
NEXT_PUBLIC_FB_APP_ID=

# --------------------------------------------------------------- その他
# 既定のタイムゾーン
DEFAULT_TIMEZONE=Asia/Tokyo

# SQLite ファイルの場所（相対パスならプロジェクトルート基準）
DATABASE_FILE=data/sukima.sqlite
